proxy_cache_path {{ virtual_host.static_cache_path }}
    levels=1:2
    keys_zone={{ virtual_host.static_cache_zone }}:10m
    max_size={{ nginx_static_cache_max_size }}
    inactive=7d
    use_temp_path=off;
{% if virtual_host.uploads_enabled | bool %}
proxy_cache_path {{ virtual_host.uploads_cache_path }}
    levels=1:2
    keys_zone={{ virtual_host.uploads_cache_zone }}:20m
    max_size={{ nginx_uploads_cache_max_size }}
    inactive=30d
    use_temp_path=off;
{% endif %}

server {
    listen {{ nginx_listen_port }};
    listen [::]:{{ nginx_listen_port }};

    server_name {{ virtual_host.server_name }};

    default_type text/plain;

    location /assets/ {
        proxy_pass {{ virtual_host.app_upstream }};
        proxy_cache {{ virtual_host.static_cache_zone }};
        proxy_cache_valid 200 5d;
        add_header X-Cache-Status $upstream_cache_status always;
    }

{% if virtual_host.uploads_enabled | bool %}
    location /uploads/ {
        proxy_pass {{ virtual_host.uploads_upstream }};
        proxy_cache {{ virtual_host.uploads_cache_zone }};
        proxy_cache_valid 200 5d;
        add_header X-Cache-Status $upstream_cache_status always;
    }
{% endif %}

    location / {
        proxy_pass {{ virtual_host.app_upstream }};
    }
}
