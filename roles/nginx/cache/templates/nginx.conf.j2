user www-data;

events {
}

http {
    proxy_cache_path {{ nginx_static_cache_path }}
        levels=1:2
        keys_zone=project_static:10m
        max_size={{ nginx_static_cache_max_size }}
        inactive=7d
        use_temp_path=off;
    proxy_cache_path {{ nginx_uploads_cache_path }}
        levels=1:2
        keys_zone=project_uploads:20m
        max_size={{ nginx_uploads_cache_max_size }}
        inactive=30d
        use_temp_path=off;

    server {
        listen {{ nginx_listen_port }};
        listen [::]:{{ nginx_listen_port }};

        server_name {{ nginx_server_name }};

        default_type text/plain;

        location /assets/ {
            proxy_pass {{ nginx_app_upstream }};
            proxy_cache project_static;
            proxy_cache_valid 200 5d;
            add_header X-Cache-Status $upstream_cache_status always;
        }

        location /uploads/ {
            proxy_pass {{ nginx_uploads_upstream }}/{{ nginx_uploads_bucket }}/;
            proxy_cache project_uploads;
            proxy_cache_valid 200 5d;
            add_header X-Cache-Status $upstream_cache_status always;
        }

        location / {
            proxy_pass {{ nginx_app_upstream }};
        }
    }
}
