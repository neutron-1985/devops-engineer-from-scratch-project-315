user www-data;

events {
}

http {
    proxy_cache_path {{ nginx_static_cache_path }}
        levels=1:2
        keys_zone=project_static:10m
        max_size={{ nginx_static_cache_max_size }}
        inactive=7d
        use_temp_path=off;
    proxy_cache_path {{ nginx_uploads_cache_path }}
        levels=1:2
        keys_zone=project_uploads:20m
        max_size={{ nginx_uploads_cache_max_size }}
        inactive=30d
        use_temp_path=off;

    server {
        listen {{ nginx_listen_port }};
        listen [::]:{{ nginx_listen_port }};

        server_name {{ nginx_server_name }};

        default_type text/plain;

        location ^~ /.well-known/acme-challenge/ {
            root {{ tls_nginx_acme_webroot }};
            try_files $uri =404;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen {{ tls_nginx_listen_port }} ssl;
        listen [::]:{{ tls_nginx_listen_port }} ssl;

        server_name {{ nginx_server_name }};

        default_type text/plain;

        # Certificate chain and private key managed and renewed by Certbot.
        ssl_certificate /etc/letsencrypt/live/{{ tls_nginx_certificate_name }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ tls_nginx_certificate_name }}/privkey.pem;

        # Allow only modern TLS protocol versions.
        ssl_protocols {{ tls_nginx_protocols }};

        # TLS 1.2 cipher allowlist: ECDHE with authenticated AEAD encryption.
        ssl_ciphers {{ tls_nginx_tls12_ciphers | join(':') }};

        # TLS 1.3 ciphers are configured separately from ssl_ciphers.
        ssl_conf_command Ciphersuites {{ tls_nginx_tls13_ciphers | join(':') }};

        # All allowed ciphers are secure, so clients may choose their preferred one.
        ssl_prefer_server_ciphers off;

        # Reuse sessions through the shared cache without stateless session tickets.
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        location /assets/ {
            proxy_pass {{ nginx_app_upstream }};
            proxy_cache project_static;
            proxy_cache_valid 200 5d;
            add_header X-Cache-Status $upstream_cache_status always;
        }

        location /uploads/ {
            proxy_pass {{ nginx_uploads_upstream }}/{{ nginx_uploads_bucket }}/;
            proxy_cache project_uploads;
            proxy_cache_valid 200 5d;
            add_header X-Cache-Status $upstream_cache_status always;
        }

        location / {
            proxy_pass {{ nginx_app_upstream }};
        }
    }
}
