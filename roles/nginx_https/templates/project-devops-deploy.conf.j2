proxy_cache_path {{ nginx_static_cache_path }} levels=1:2 keys_zone=project_static:10m
                 max_size={{ nginx_static_cache_max_size }} inactive=7d use_temp_path=off;
proxy_headers_hash_max_size 1024;
proxy_headers_hash_bucket_size 128;
{% if nginx_uploads_enabled | bool %}
proxy_cache_path {{ nginx_uploads_cache_path }} levels=1:2 keys_zone=project_uploads:20m
                 max_size={{ nginx_uploads_cache_max_size }} inactive=30d use_temp_path=off;
{% endif %}

server {
    listen {{ nginx_listen_port }};
    listen [::]:{{ nginx_listen_port }};
    server_name {{ nginx_server_name }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
        default_type text/plain;
        try_files $uri =404;
    }

{% if nginx_https_certificate_exists | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{ nginx_https_listen_port }} ssl;
    listen [::]:{{ nginx_https_listen_port }} ssl;
    server_name {{ nginx_server_name }};

    ssl_certificate /etc/letsencrypt/live/{{ nginx_https_certificate_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_https_certificate_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
{% endif %}

    client_max_body_size {{ nginx_client_max_body_size }};

    location /assets/ {
        proxy_pass {{ nginx_app_upstream }};
        proxy_cache project_static;
        proxy_cache_methods GET HEAD;
        proxy_cache_lock on;
        proxy_cache_valid 200 365d;
        proxy_cache_valid 404 1m;
        proxy_hide_header Cache-Control;
        expires 365d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Cache-Status $upstream_cache_status always;

        include proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

{% if nginx_uploads_enabled | bool %}
    location /uploads/ {
        proxy_pass {{ nginx_uploads_upstream }}/{{ nginx_uploads_bucket }}/;
        proxy_cache project_uploads;
        proxy_cache_methods GET HEAD;
        proxy_cache_lock on;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_hide_header Cache-Control;
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
    }
{% endif %}

    location / {
        proxy_pass {{ nginx_app_upstream }};
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;

        include proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
